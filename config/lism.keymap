#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <input/processors.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <350>;        // 修飾キーが出るまでの長押し時間
    require-prior-idle-ms = <150>;  // 直前のキー入力から150ms以内なら必ずタップ扱い（タイピング中の誤発動防止）
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q             &kp W     &kp E                    &kp R           &kp T                                               &kp Y           &kp U           &kp I            &kp O      &lt 7 P
&mt LCMD A        &kp S     &kp D                    &kp F           &kp G                                               &kp H           &kp J           &kp K            &kp L      &kp MINUS
&mt LEFT_SHIFT Z  &kp X     &kp C                    &kp V           &kp B                                               &kp N           &kp M           &kp COMMA        &kp DOT    &mt RIGHT_SHIFT SLASH
&kp RCTRL         &kp LALT  &mt LCMD LANGUAGE_2      &msc SCRL_UP    &lt 1 SPACE      &lt 2 LANGUAGE_1    &kp BACKSPACE  &lt 3 ENTER     &msc SCRL_UP    &kp F7           &lt 4 F12  &lt 5 ESC
                            &msc SCRL_LEFT           &msc SCRL_DOWN  &msc SCRL_RIGHT                                     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        // moNa2 layer_3 を流用（数字 / ファンクション）
        layer_1 {
            display-name = "Number Layer";
            bindings = <
&kp ESC         &kp F9  &kp F10  &kp F11  &kp F12                    &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS
&trans          &kp F5  &kp F6   &kp F7   &kp F8                     &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&kp LEFT_SHIFT  &kp F1  &kp F2   &kp F3   &kp F4                     &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL
&trans          &trans  &trans   &trans   &trans   &trans    &trans  &trans        &trans        &trans        &trans        &trans
                        &trans   &trans   &trans                     &trans        &trans        &trans
            >;
        };

        // moNa2 layer_5 を流用（カーソル / ナビゲーション、Mac用）
        layer_2 {
            display-name = "Navigation Layer";
            bindings = <
&kp PAGE_UP       &kp LC(LS(TAB))  &kp UP_ARROW    &kp LC(TAB)      &kp PAGE_DOWN                                 &trans  &kp LA(LC(V))     &kp LC(RA(F))  &trans                &trans
&kp HOME          &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END                                       &trans  &kp LC(LEFT_ALT)  &trans         &kp LC(RA(LEFT_WIN))  &trans
&trans            &trans           &trans          &trans           &kp LG(LS(LC(N4)))                            &trans  &trans            &kp LG(M)      &trans                &trans
&kp LEFT_CONTROL  &trans           &trans          &trans           &trans              &trans                    &trans  &trans            &trans         &trans                &trans  &trans
                                   &trans          &trans           &trans                                        &trans  &trans            &trans
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        // moNa2 layer_2 を流用（記号）
        layer_3 {
            display-name = "Mark Layer";
            bindings = <
&kp GRAVE              &trans           &trans       &trans         &trans                           &trans        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp MINUS             &kp EQUAL
&trans                 &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp DOLLAR                       &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH         &kp SEMICOLON
&mt RIGHT_SHIFT MINUS  &kp PERCENT      &kp CARET    &kp AMPERSAND  &trans                           &kp HASH      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE              &trans
&trans                 &trans           &trans       &trans         &trans      &trans    &trans     &trans        &trans                &trans                 &trans                &kp F12
                                        &trans       &trans         &trans                           &trans        &trans                &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
&none        &none           &none   &none   &bt BT_CLR                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none        &none           &none   &none   &none                                &none         &none         &none         &none         &none
&sys_reset   &none           &none   &none   &none                                &none         &none         &none         &none         &sys_reset
&bootloader  &bt BT_CLR_ALL  &none   &none   &none       &none    &studio_unlock  &none         &none         &none         &none         &bootloader
                             &trans  &trans  &trans                               &trans        &trans        &trans
            >;
        };

        layer_5 {
            display-name = "Blank Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };

        // moNa2 の MOUSE レイヤーを流用。
        // トラックボールを動かすと zip_temp_layer によって自動で有効化される。
        layer_6 {
            display-name = "Mouse Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
                &trans  &trans  &trans                    &trans  &trans    &trans
            >;
        };

        // moNa2 の SCROLL レイヤーを流用。
        // 中身は全て &trans で、トラックボールをスクロールに切り替えるためだけの層。
        // （snippets 側の input-listener の scroller { layers = <7>; } と対応）
        layer_7 {
            display-name = "Scroll Layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans                    &trans  &trans  &trans
            >;
        };
    };
};

// オートマウスレイヤー（layer 6）を解除しないキー位置。
// ここに列挙した位置は、押しても一時レイヤーが解除されない。
&zip_temp_layer {
    excluded-positions = <
        16  // J (MB1)
        17  // K (MB3)
        18  // L (MB2)
        26  // M (MB4)
        28  // . (MB5)
    >;
};
